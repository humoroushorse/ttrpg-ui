{
  "name": "@ttrpg-ui/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "npx nx",
    "nx": "npx nx",
    "start": "nx serve",
    "build": "nx build",
    "reset": "nx reset",
    "lint": "nx workspace-lint && ng lint",
    "prettier:check": "prettier --config .prettierrc --check \"src/**/*.{ts,css,html}\"",
    "// - CORE SCRIPTS": "core scripts",
    "install": "npm install husky",
    "prepare": "husky",
    "// - TARGET APPS": "app specific scripts",
    "host-dnd:serve": "nx serve host-dnd --skip-nx-cache --verbose",
    "host-dnd:test": "nx run host-dnd:test",
    "host-dnd:test:ci": "nx test host-dnd --ci --max-workers=4",
    "host-dnd:test:affected": "npm run affected:test --uncomitted",
    "host-dnd:test:e2e": "ng e2e host-dnd",
    "host-dnd:test:e2e:ci": "ng e2e host-dnd --headless",
    "// - ALL": "run against all projects with given target",
    "all:test": "nx run-many --all --target=test --parallel=5 --silent --runInBand",
    "all:test:report:text-summary": "npx istanbul report --dir coverage --include coverage/**/coverage-final.json text-summary",
    "all:test:report:html": "npx istanbul report --dir coverage --include coverage/**/coverage-final.json html",
    "all:lint": "nx run-many --all --target=lint --parallel --verbose",
    "// - AFFECTED": "run on only affected modules",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:deploy": "nx affected:deploy",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "// - FORMAT": "format and lint utils",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "migrate:latest": "nx migrate latest",
    "migrate:run": "nx migrate --run-migrations",
    "workplace-schematic": "nx workspace-schematic",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dep-graph": "nx dep-graph",
    "help": "nx-help",
    "// - BUNDLE ANALYSIS": "bundle size visualization",
    "analyze:sprint": "nx build sprint-management --stats-json && esbuild-visualizer --metadata dist/apps/sprint-management/browser/stats.json --open",
    "analyze:sprint:prod": "nx build sprint-management --configuration=production --stats-json && esbuild-visualizer --metadata dist/apps/sprint-management/browser/stats.json --open",
    "analyze:dnd": "nx build dnd --stats-json && esbuild-visualizer --metadata dist/apps/dnd/browser/stats.json --open",
    "analyze:dnd:prod": "nx build dnd --configuration=production --stats-json && esbuild-visualizer --metadata dist/apps/dnd/browser/stats.json --open"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^22.1.2",
    "@angular/animations": "22.1.0",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/platform-browser-dynamic": "22.1.0",
    "@angular/platform-server": "22.1.0",
    "@angular/router": "22.1.0",
    "@angular/service-worker": "22.1.0",
    "@angular/ssr": "22.0.9",
    "@ngrx/entity": "21.1.0",
    "@ngrx/operators": "21.1.0",
    "@ngrx/signals": "21.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "ngx-cookie-service": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/core": "22.0.9",
    "@angular-devkit/schematics": "22.0.9",
    "@angular/build": "22.0.9",
    "@angular/cli": "22.0.9",
    "@angular/compiler-cli": "22.1.0",
    "@angular/language-service": "22.1.0",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "10.0.1",
    "@nx/angular": "23.1.1",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@playwright/test": "^1.60.0",
    "@schematics/angular": "22.0.9",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.21",
    "@types/express": "^5.0.6",
    "@types/node": "25.9.1",
    "@typescript-eslint/utils": "^8.59.4",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.10.4",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jiti": "2.7.0",
    "jsdom": "~30.0.1",
    "nx": "23.1.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "{apps,libs}/**/*.{ts,json,md,html}": [
      "npm run affected:lint --uncomitted --parallel --fix=true",
      "prettier --write"
    ],
    "{apps,libs}/**/*.{css,les,sass,scss,sss}": [
      "npx stylelint --fix --allow-empty-input",
      "prettier --write"
    ]
  }
}
