{
  "name": "dnd-spells-models",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "features/dnd/models/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["dnd", "models"],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "config": "features/dnd/spells/models/vite.config.mts"
      }
    },
    "test:jest": {
      "executor": "@nx/jest:jest",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "jestConfig": "features/dnd/spells/models/jest.config.ts",
        "tsConfig": "features/dnd/spells/models/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
