import { inject } from '@angular/core';
import { rxResource } from '@angular/core/rxjs-interop';
import { nonBlocking, ResourceContext } from '@angular/router';
import { <%= serviceClass %> } from '../services/<%= name %>-api.service';

/**
 * Route `resources` for `<%= name %>/<%= catalog ? ':source/:slug' : ':id' %>`, bound to the page's input of the same name.
 * Non-blocking: the page shows right away and renders the resource's loading and error states.
 */
export const <%= resourcesConst %> = (ctx: ResourceContext) => {
  const api = inject(<%= serviceClass %>);
  const <%= singularProp %> = rxResource({
<% if (catalog) { %>    params: () => {
      const { source, slug } = ctx.params();
      return source && slug ? { source: source as string, slug: slug as string } : undefined;
    },
    stream: ({ params }) => api.getBySlugs(params.source, params.slug),
<% } else { %>    params: () => (ctx.params()['id'] as string | undefined) || undefined,
    stream: ({ params: id }) => api.getById(id),
<% } %>  });
  return { <%= singularProp %>: nonBlocking(<%= singularProp %>) };
};
