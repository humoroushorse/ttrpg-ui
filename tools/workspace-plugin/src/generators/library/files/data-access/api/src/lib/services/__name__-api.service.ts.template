import { computed, inject, Injectable } from '@angular/core';
import { HttpClient, HttpParams } from '@angular/common/http';
import { map, Observable } from 'rxjs';
import { SharedModels } from '@ttrpg-ui/shared/models';
import { <%= modelsNamespace %> } from '<%= modelsImport %>';

type <%= Singular %> = <%= modelsNamespace %>.<%= Plural %>.<%= Singular %>Schema;

/** The API's list response */
interface <%= Singular %>QueryResponse {
  entities?: <%= Singular %>[];
  total_entities_count?: number;
}
<% if (catalog) { %>
/**
 * The fields the list page's columns use (id always comes back). Without `?fields=` the list
 * would carry every entry's big JSON columns.
 */
const LIST_FIELDS: (keyof <%= Singular %>)[] = [
  'source',
  'slug',
  'name',
  'dnd_version_year',
  'is_unearthed_arcana',
  'is_homebrew',
];
<% } %>
/** The <%= name %> API: <%= apiPath %> under the configured base path */
@Injectable({ providedIn: 'root' })
export class <%= serviceClass %> {
  private readonly config = inject(<%= modelsNamespace %>.Service.<%= tokenName %>);

  private readonly http = inject(HttpClient);

  // a signal: app.config.json can load after this service is created
  private readonly url = computed(() => `${this.config.appConfig().<%= apiBasePathKey %>}<%= apiPath %>`);

  /** One page. Sort and filters go as JSON (AG Grid-shaped models), as the shared table emits them */
  getList(query: SharedModels.Store.ListQuery): Observable<SharedModels.Store.ListResponse<<%= Singular %>>> {
    let params = new HttpParams().set('limit', query.limit).set('offset', query.offset);
    if (query.sort) params = params.set('sort', JSON.stringify([query.sort]));
    if (Object.keys(query.filters).length) params = params.set('filter', JSON.stringify(query.filters));
<% if (catalog) { %>    params = params.set('fields', LIST_FIELDS.join(','));
<% } %>    return this.http
      .get<<%= Singular %>QueryResponse>(`${this.url()}/query`, { params })
      .pipe(map((r) => ({ entities: r.entities ?? [], total: r.total_entities_count ?? r.entities?.length ?? 0 })));
  }

  getById(id: string): Observable<<%= Singular %>> {
    return this.http.get<<%= Singular %>>(`${this.url()}/${encodeURIComponent(id)}`);
  }
<% if (catalog) { %>
  /** The URL key: the source's slug and the entry's (phb_2024, ...) */
  getBySlugs(sourceSlug: string, slug: string): Observable<<%= Singular %>> {
    const path = [sourceSlug, slug].map(encodeURIComponent).join('/');
    return this.http.get<<%= Singular %>>(`${this.url()}/${path}`);
  }
<% } %><% if (!readOnly) { %>
  create(body: Partial<<%= Singular %>>): Observable<<%= Singular %>> {
    return this.http.post<<%= Singular %>>(this.url(), body);
  }

  patch(id: string, body: Partial<<%= Singular %>>): Observable<<%= Singular %>> {
    return this.http.patch<<%= Singular %>>(`${this.url()}/${encodeURIComponent(id)}`, body);
  }

  /** Soft delete. Returns the id. */
  delete(id: string): Observable<string> {
    return this.http.delete<string>(`${this.url()}/${encodeURIComponent(id)}`);
  }
<% } %>}
