import { ChangeDetectionStrategy, Component, computed, inject, input, linkedSignal, Resource, signal } from '@angular/core';
import { HttpErrorResponse } from '@angular/common/http';
import { Router, RouterLink } from '@angular/router';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatIconModule } from '@angular/material/icon';
import { MatInputModule } from '@angular/material/input';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { pageMeta } from '@ttrpg-ui/shared/core/util';
import { getErrorMessage } from '@ttrpg-ui/shared/store/util';
import { <%= modelsNamespace %> } from '<%= modelsImport %>';
import { <%= storeName %> } from '<%= dataAccessImport %>';

type <%= Singular %> = <%= modelsNamespace %>.<%= Plural %>.<%= Singular %>Schema;

/** `value()` throws while a resource is in error, so read it through this */
const valueOf = <T>(res: Resource<T | undefined>): T | undefined => (res.hasValue() ? res.value() : undefined);

/** The textarea's JSON as a request body, or why it isn't one */
const parseBody = (text: string): { body: Partial<<%= Singular %>> } | { error: string } => {
  try {
    const body: unknown = JSON.parse(text);
    return body && typeof body === 'object' && !Array.isArray(body)
      ? { body: body as Partial<<%= Singular %>> }
      : { error: 'The body must be a JSON object.' };
  } catch (error) {
    return { error: `Not valid JSON: ${(error as Error).message}` };
  }
};

@Component({
  selector: '<%= pageSelector %>',
  imports: [RouterLink, MatButtonModule, MatCardModule, MatFormFieldModule, MatIconModule, MatInputModule, MatProgressBarModule],
  templateUrl: './<%= pageFolder %>.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class <%= pageClass %> {
  private readonly router = inject(Router);

  protected readonly store = inject(<%= storeName %>);

  /** Route resource (`<%= resourcesConst %>`) */
  readonly <%= singularProp %> = input.required<Resource<<%= Singular %> | undefined>>();

  protected readonly loaded = computed(() => valueOf(this.<%= singularProp %>()));

  protected readonly viewRoute = <%= modelsNamespace %>.<%= Plural %>.<%= routeFn %>;

  /** placeholder until this page gets a real form: the loaded <%= singularWords %> as JSON, then what the user types */
  protected readonly json = linkedSignal(() => {
    const <%= singularProp %> = this.loaded();
    return <%= singularProp %> ? JSON.stringify(<%= singularProp %>, null, 2) : '';
  });

  private readonly parseError = signal<string | null>(null);

  private readonly submitted = signal(false);

  protected readonly loadError = computed(() => {
    const error = this.<%= singularProp %>().error();
    if (!error) return null;
    return error instanceof HttpErrorResponse && error.status === 404 ? '<%= SingularTitle %> not found.' : getErrorMessage(error);
  });

  /** The JSON's problem, or the API's once the user has submitted */
  protected readonly errorMessage = computed(() => this.parseError() ?? (this.submitted() ? this.store.error() : null));

  constructor() {
    pageMeta(() => ({
      title: [`Edit ${this.loaded()?.name ?? '<%= SingularTitle %>'}`, '<%= PluralTitle %>'],
      description: 'Edit <%= a %> <%= singularWords %>.',
    }));
  }

  onSubmit(<%= singularProp %>: <%= Singular %>): void {
    const parsed = parseBody(this.json());
    this.parseError.set('error' in parsed ? parsed.error : null);
    if ('error' in parsed) return;
    this.submitted.set(true);
    this.store.update({
      id: <%= singularProp %>.id,
      body: parsed.body,
      onUpdated: (updated) => this.router.navigate(<%= modelsNamespace %>.<%= Plural %>.<%= routeFn %>(updated)),
    });
  }
}
