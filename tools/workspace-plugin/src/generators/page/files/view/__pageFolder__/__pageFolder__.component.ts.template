import { ChangeDetectionStrategy, Component, computed, <% if (hasDelete) { %>inject, <% } %>input, linkedSignal, Resource } from '@angular/core';
import { JsonPipe } from '@angular/common';
import { HttpErrorResponse } from '@angular/common/http';
import { <% if (hasDelete) { %>Router, <% } %>RouterLink } from '@angular/router';
import { MatButtonModule } from '@angular/material/button';
import { MatCardModule } from '@angular/material/card';
import { MatIconModule } from '@angular/material/icon';
import { MatProgressBarModule } from '@angular/material/progress-bar';
import { pageMeta } from '@ttrpg-ui/shared/core/util';
import { getErrorMessage } from '@ttrpg-ui/shared/store/util';
import { <%= modelsNamespace %> } from '<%= modelsImport %>';
<% if (hasDelete) { %>import { <%= storeName %> } from '<%= dataAccessImport %>';
<% } %>
type <%= Singular %> = <%= modelsNamespace %>.<%= Plural %>.<%= Singular %>Schema;

/** `value()` throws while a resource is in error, so read it through this */
const valueOf = <T>(res: Resource<T | undefined>): T | undefined => (res.hasValue() ? res.value() : undefined);

@Component({
  selector: '<%= pageSelector %>',
  imports: [JsonPipe, RouterLink, MatButtonModule, MatCardModule, MatIconModule, MatProgressBarModule],
  templateUrl: './<%= pageFolder %>.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class <%= pageClass %> {
<% if (hasDelete) { %>  private readonly router = inject(Router);

  protected readonly store = inject(<%= storeName %>);

<% } %>  /** Route resource (`<%= resourcesConst %>`) */
  readonly <%= singularProp %> = input.required<Resource<<%= Singular %> | undefined>>();

  /** Keeps the last <%= singularWords %> on screen while the next one loads */
  protected readonly shown = linkedSignal<<%= Singular %> | undefined, <%= Singular %> | undefined>({
    source: () => valueOf(this.<%= singularProp %>()),
    computation: (value, previous) => value ?? previous?.value,
  });

  protected readonly errorMessage = computed(() => {
    const error = this.<%= singularProp %>().error();
    if (!error) return null;
    return error instanceof HttpErrorResponse && error.status === 404 ? '<%= SingularTitle %> not found.' : getErrorMessage(error);
  });

  constructor() {
    pageMeta(() => {
      const <%= singularProp %> = this.shown();
<% if (catalog) { %>      // the 2014 and 2024 printings share a name, so the title says which
      return {
        title: [
          <%= singularProp %> ? `${<%= singularProp %>.name} (${<%= singularProp %>.source.name_short} ${<%= singularProp %>.dnd_version_year})` : '<%= SingularTitle %>',
          '<%- ListTitle %>',
        ],
        description: <%= singularProp %>
          ? `${<%= singularProp %>.name}, a <%- itemWords %> from ${<%= singularProp %>.source.name} (${<%= singularProp %>.dnd_version_year}).`
          : 'View a <%- itemWords %>.',
      };
<% } else { %>      return {
        title: [<%= singularProp %>?.name ?? '<%= SingularTitle %>', '<%= PluralTitle %>'],
        description: <%= singularProp %> ? `${<%= singularProp %>.name}, <%= a %> <%= singularWords %>.` : 'View <%= a %> <%= singularWords %>.',
      };
<% } %>    });
  }
<% if (hasDelete) { %>
  onDeleteClicked(<%= singularProp %>: <%= Singular %>): void {
    if (!confirm(`Delete ${<%= singularProp %>.name}?`)) return;
    this.store.delete({ entity: <%= singularProp %>, onDeleted: () => this.router.navigate(['/', '<%= scope %>', '<%= name %>']) });
  }
<% } %>}
