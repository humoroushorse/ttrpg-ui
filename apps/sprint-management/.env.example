# Sprint Management App - Environment Variables
# Copy this file to .env and update with your values

# Sprint Management API Configuration
APP_SPRINT_MANAGEMENT__API_BASE_PATH=/sprint-management-api
APP_SPRINT_MANAGEMENT__API_URL=http://localhost:8003

# Auth API Configuration
AUTH_BASE_URL=/auth-api

# Server Port (optional, defaults to 4000)
PORT=4000
