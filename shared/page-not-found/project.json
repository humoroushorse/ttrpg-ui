{
  "name": "shared-page-not-found",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "shared/page-not-found/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../coverage/shared/page-not-found"
      }
    },
    "test:jest": {
      "executor": "@nx/jest:jest",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "jestConfig": "shared/page-not-found/jest.config.ts",
        "tsConfig": "shared/page-not-found/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
